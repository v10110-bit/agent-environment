{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "discovery": {
      "description": "Investigate repositories and alternatives; conduct approved scratch experiments",
      "model": "opencode/gpt-6.1-sol#high",
      "system": "{file:agents/discovery.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "{file:~/.config/agent-environment/workspace-scope}", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "{file:~/.config/agent-environment/discovery-scope}", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Inspect requirements and code; produce actionable plans and acceptance criteria",
      "model": "opencode/gpt-6.1-sol#medium",
      "system": "{file:agents/plan.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "{file:~/.config/agent-environment/workspace-scope}", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "docs/plans/*", "effect": "ask" },
        { "action": "edit", "resource": "{file:~/.config/agent-environment/plans-scope}", "effect": "ask" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "build": {
      "description": "Implement approved tasks, test and debug",
      "model": "opencode/gpt-6.1-sol#low",
      "system": "{file:agents/build.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "{file:~/.config/agent-environment/workspace-scope}", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "allow" },
        { "action": "shell", "resource": "bun", "effect": "allow" },
        { "action": "shell", "resource": "bun *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm *", "effect": "allow" },
        { "action": "shell", "resource": "node *", "effect": "allow" },
        { "action": "shell", "resource": "docker version *", "effect": "allow" },
        { "action": "shell", "resource": "docker context show *", "effect": "allow" },
        { "action": "shell", "resource": "docker context inspect *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose version *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose config --quiet", "effect": "allow" },
        { "action": "shell", "resource": "docker compose build *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose up *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose logs *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose stop *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose down", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * config --quiet", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * build *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * up *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * logs *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * ps *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * stop *", "effect": "allow" },
        { "action": "shell", "resource": "docker compose -p * down", "effect": "allow" },
        { "action": "shell", "resource": "ss -ltn *", "effect": "allow" },
        { "action": "shell", "resource": "curl http://127.0.0.1:*", "effect": "allow" },
        { "action": "shell", "resource": "curl http://localhost:*", "effect": "allow" },
        { "action": "shell", "resource": "curl --fail http://127.0.0.1:*", "effect": "allow" },
        { "action": "shell", "resource": "curl --fail http://localhost:*", "effect": "allow" },
        { "action": "shell", "resource": "git *commit*", "effect": "ask" },
        { "action": "shell", "resource": "git *push*", "effect": "ask" },
        { "action": "shell", "resource": "git *reset*", "effect": "ask" },
        { "action": "shell", "resource": "git *clean*", "effect": "ask" },
        { "action": "shell", "resource": "git *checkout*", "effect": "ask" },
        { "action": "shell", "resource": "git *restore*", "effect": "ask" },
        { "action": "shell", "resource": "git *rm*", "effect": "ask" },
        { "action": "shell", "resource": "git *branch *-D*", "effect": "ask" },
        { "action": "shell", "resource": "git *branch *-d*", "effect": "ask" },
        { "action": "shell", "resource": "git *clone*", "effect": "ask" },
        { "action": "shell", "resource": "git *submodule*", "effect": "ask" },
        { "action": "shell", "resource": "bun *install*", "effect": "ask" },
        { "action": "shell", "resource": "bun *add*", "effect": "ask" },
        { "action": "shell", "resource": "bun *update*", "effect": "ask" },
        { "action": "shell", "resource": "bun *publish*", "effect": "ask" },
        { "action": "shell", "resource": "bun *create*", "effect": "ask" },
        { "action": "shell", "resource": "bun *x *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *publish*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *deploy*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *dlx*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *--global*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm -g *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm * -g *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *config *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *setup*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *self-update*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm *env *", "effect": "ask" },
        { "action": "shell", "resource": "docker *--push*", "effect": "ask" },
        { "action": "shell", "resource": "docker *--output*", "effect": "ask" },
        { "action": "shell", "resource": "docker *--volumes*", "effect": "ask" },
        { "action": "shell", "resource": "docker *--renew-anon-volumes*", "effect": "ask" },
        { "action": "shell", "resource": "docker *--remove-orphans*", "effect": "ask" },
        { "action": "shell", "resource": "docker *--context*", "effect": "ask" },
        { "action": "shell", "resource": "docker * -c *", "effect": "ask" },
        { "action": "shell", "resource": "docker *--host*", "effect": "ask" },
        { "action": "shell", "resource": "docker * -H*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "review": {
      "description": "Independently review correctness and acceptance criteria without application edits",
      "model": "opencode/gpt-6.1-sol#high",
      "system": "{file:agents/review.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "{file:~/.config/agent-environment/workspace-scope}", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    }
  }
}
